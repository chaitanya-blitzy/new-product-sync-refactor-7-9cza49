{
  "name": "node-tutorial-backend",
  "version": "1.0.0",
  "description": "Node.js tutorial application backend demonstrating Express.js 5.1.0, TypeScript, and modern development practices",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "author": "Node.js Tutorial Team",
  "license": "MIT",
  "keywords": [
    "nodejs",
    "express",
    "typescript",
    "tutorial",
    "backend",
    "api",
    "educational",
    "http-server"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/nodejs-tutorial/backend.git"
  },
  "bugs": {
    "url": "https://github.com/nodejs-tutorial/backend/issues"
  },
  "homepage": "https://github.com/nodejs-tutorial/backend#readme",
  "engines": {
    "node": ">=24.0.0",
    "npm": ">=11.0.0"
  },
  "scripts": {
    "build": "rimraf dist && tsc",
    "start": "node dist/index.js",
    "dev": "nodemon --exec ts-node src/index.ts",
    "dev:debug": "nodemon --exec node --inspect ts-node/register src/index.ts",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:ci": "jest --ci --coverage --watchAll=false",
    "lint": "eslint src/**/*.ts tests/**/*.ts",
    "lint:fix": "eslint src/**/*.ts tests/**/*.ts --fix",
    "format": "prettier --write src/**/*.ts tests/**/*.ts",
    "format:check": "prettier --check src/**/*.ts tests/**/*.ts",
    "type-check": "tsc --noEmit",
    "clean": "rimraf dist coverage node_modules/.cache",
    "prebuild": "npm run clean && npm run lint && npm run type-check",
    "postbuild": "echo 'Build completed successfully'",
    "prestart": "npm run build",
    "validate": "npm run lint && npm run type-check && npm run test:coverage",
    "dev:build": "concurrently \"tsc --watch\" \"nodemon dist/index.js\"",
    "health-check": "node -e \"require('http').get('http://localhost:3000/health', (res) => { console.log('Health check:', res.statusCode === 200 ? 'OK' : 'FAIL'); process.exit(res.statusCode === 200 ? 0 : 1); })\""
  },
  "dependencies": {
    "express": "^5.1.0",
    "helmet": "^7.1.0",
    "cors": "^2.8.5",
    "express-rate-limit": "^7.1.5",
    "compression": "^1.7.4",
    "morgan": "^1.10.0",
    "winston": "^3.15.0",
    "dotenv": "^16.4.7"
  },
  "devDependencies": {
    "typescript": "^5.3.0",
    "@types/node": "^24.0.0",
    "@types/express": "^5.0.0",
    "@types/cors": "^2.8.17",
    "@types/compression": "^1.7.5",
    "@types/morgan": "^1.9.9",
    "jest": "^29.7.0",
    "@types/jest": "^29.5.14",
    "@jest/globals": "^29.0.0",
    "@jest/types": "^29.0.0",
    "ts-jest": "^29.2.5",
    "supertest": "^6.3.0",
    "@types/supertest": "^6.0.2",
    "nodemon": "^3.1.7",
    "ts-node": "^10.9.2",
    "eslint": "^9.12.0",
    "@typescript-eslint/parser": "^8.8.1",
    "@typescript-eslint/eslint-plugin": "^8.8.1",
    "eslint-plugin-security": "^2.1.0",
    "eslint-plugin-node": "^11.1.0",
    "eslint-plugin-import": "^2.29.0",
    "eslint-plugin-promise": "^6.1.0",
    "prettier": "^3.3.3",
    "rimraf": "^6.0.1",
    "concurrently": "^9.1.0"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "roots": [
      "<rootDir>/src",
      "<rootDir>/tests"
    ],
    "testMatch": [
      "**/__tests__/**/*.ts",
      "**/?(*.)+(spec|test).ts"
    ],
    "transform": {
      "^.+\\.ts$": "ts-jest"
    },
    "coverageDirectory": "coverage",
    "collectCoverageFrom": [
      "src/**/*.ts",
      "!src/**/*.d.ts",
      "!src/**/*.test.ts",
      "!src/**/__tests__/**"
    ],
    "coverageReporters": [
      "text",
      "lcov",
      "html"
    ],
    "coverageThreshold": {
      "global": {
        "branches": 100,
        "functions": 100,
        "lines": 100,
        "statements": 100
      }
    }
  },
  "nodemonConfig": {
    "watch": [
      "src"
    ],
    "ext": "ts",
    "ignore": [
      "src/**/*.test.ts"
    ],
    "exec": "ts-node src/index.ts"
  },
  "eslintConfig": {
    "parser": "@typescript-eslint/parser",
    "extends": [
      "eslint:recommended",
      "@typescript-eslint/recommended",
      "plugin:security/recommended",
      "plugin:node/recommended",
      "plugin:import/recommended",
      "plugin:promise/recommended"
    ],
    "plugins": [
      "@typescript-eslint",
      "security",
      "node",
      "import",
      "promise"
    ],
    "parserOptions": {
      "ecmaVersion": 2024,
      "sourceType": "module"
    },
    "env": {
      "node": true,
      "es2024": true,
      "jest": true
    },
    "rules": {
      "node/no-missing-import": "off",
      "node/no-unsupported-features/es-syntax": "off"
    }
  },
  "prettier": {
    "semi": true,
    "trailingComma": "es5",
    "singleQuote": true,
    "printWidth": 80,
    "tabWidth": 2,
    "useTabs": false
  }
}