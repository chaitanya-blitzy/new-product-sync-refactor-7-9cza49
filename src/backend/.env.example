# ==============================================================================
# ENVIRONMENT CONFIGURATION TEMPLATE
# Node.js Tutorial Application - Express.js 5.1.0 + Node.js 24.x
# ==============================================================================
#
# IMPORTANT SECURITY NOTICE:
# - This is a TEMPLATE file - DO NOT commit actual .env files to version control
# - Copy this file to .env and modify values according to your environment
# - Use different values for each environment (development, staging, production)
# - Store sensitive production values in secure environment variable systems
# - Never use wildcard (*) CORS origins in production with credentials enabled
#
# SETUP INSTRUCTIONS:
# 1. Copy this file: cp .env.example .env
# 2. Modify values in .env according to your environment
# 3. Ensure .env is listed in your .gitignore file
# 4. Use environment-specific values for different deployments
#
# VALIDATION:
# - All environment variables are validated at application startup
# - Invalid configuration will prevent application startup with clear error messages
# - Refer to src/config/constants.ts for valid value options and validation rules
# - Check console output for configuration validation results
#
# ==============================================================================
# REQUIRED ENVIRONMENT VARIABLES
# ==============================================================================
# These variables MUST be set for the application to function properly

# Application Environment
# Controls environment-specific behavior and security settings
# Valid values: development, production, test, staging
# Default: development
# Security: Controls environment-specific behavior and security settings
NODE_ENV=development

# ==============================================================================
# SERVER CONFIGURATION
# Core HTTP server settings for Express.js 5.1.0 application
# ==============================================================================

# HTTP Server Port
# Port number for binding the HTTP server
# Valid range: 1-65535 (avoid reserved system ports 0-1023 in production)
# Default: 3000
# Security: Avoid using reserved system ports (0-1023) in production
PORT=3000

# HTTP Server Host
# Host address for binding the HTTP server
# Valid values: localhost, 0.0.0.0, 127.0.0.1, or any valid IP/hostname
# Default: localhost
# Security: Use 0.0.0.0 for container deployment, localhost for development
HOST=localhost

# Request Timeout
# Server timeout in milliseconds for request handling
# Valid range: Any positive integer (recommended: 30000-120000)
# Default: 30000
# Security: Set appropriate timeout to prevent resource exhaustion attacks
TIMEOUT=30000

# Request Size Limit
# Maximum request body size for security and performance
# Valid format: Size string (e.g., 10mb, 1gb)
# Default: 10mb
# Security: Limit request size to prevent memory exhaustion attacks
REQUEST_SIZE_LIMIT=10mb

# ==============================================================================
# LOGGING CONFIGURATION
# Application logging and monitoring settings
# ==============================================================================

# Application Logging Level
# Controls verbosity of application logs
# Valid values: error, warn, info, http, debug
# Default: info
# Security: Use info or warn in production to prevent sensitive data logging
LOG_LEVEL=info

# Debug Namespace (Development Only)
# Debug namespace for development logging with debug module
# Valid format: Debug namespace pattern (e.g., app:*, express:*, tutorial:*)
# Default: tutorial:*
# Security: Only enable in development environment
DEBUG=tutorial:*

# ==============================================================================
# SECURITY CONFIGURATION
# Security middleware and protection settings
# ==============================================================================

# CORS Origin Configuration
# Allowed CORS origins for cross-origin requests
# Valid values: Valid URL, wildcard (*), or comma-separated list
# Default: http://localhost:3000
# Security: NEVER use wildcard (*) in production with credentials enabled
CORS_ORIGIN=http://localhost:3000

# Content Security Policy
# Enable Content Security Policy headers via Helmet.js
# Valid values: true, false
# Default: true
# Security: Always enable in production for XSS protection
HELMET_CSP=true

# Rate Limiting Window
# Rate limiting time window in milliseconds
# Valid range: Any positive integer (recommended: 900000-86400000)
# Default: 900000 (15 minutes)
# Security: Configure rate limiting to prevent abuse and DoS attacks
RATE_LIMIT_WINDOW=900000

# Rate Limiting Maximum Requests
# Maximum requests allowed per rate limit window
# Valid range: Any positive integer (recommended: 100-10000)
# Default: 100
# Security: Set appropriate limits based on expected usage patterns
RATE_LIMIT_MAX=100

# ==============================================================================
# DEVELOPMENT ENVIRONMENT VARIABLES
# Variables specific to development environment
# ==============================================================================

# Hot Reload Enable
# Enable hot reloading for development workflow
# Valid values: true, false
# Default: true
# Security: Disable in production for security and performance
HOT_RELOAD=true

# ==============================================================================
# PRODUCTION ENVIRONMENT VARIABLES
# Variables specific to production environment
# ==============================================================================

# Cluster Mode
# Enable cluster mode for production horizontal scaling
# Valid values: true, false
# Default: false
# Security: Enable for production horizontal scaling
CLUSTER_MODE=false

# Trust Proxy Headers
# Trust proxy headers for load balancer integration
# Valid values: true, false
# Default: false
# Security: Only enable when behind trusted proxy or load balancer
TRUST_PROXY=false

# ==============================================================================
# ENVIRONMENT-SPECIFIC CONFIGURATION EXAMPLES
# ==============================================================================

# DEVELOPMENT ENVIRONMENT EXAMPLE:
# NODE_ENV=development
# PORT=3000
# HOST=localhost
# LOG_LEVEL=debug
# DEBUG=tutorial:*
# HOT_RELOAD=true
# CORS_ORIGIN=http://localhost:3000
# HELMET_CSP=false
# RATE_LIMIT_MAX=10000

# PRODUCTION ENVIRONMENT EXAMPLE:
# NODE_ENV=production
# PORT=8080
# HOST=0.0.0.0
# LOG_LEVEL=info
# CLUSTER_MODE=true
# TRUST_PROXY=true
# CORS_ORIGIN=https://yourdomain.com
# HELMET_CSP=true
# RATE_LIMIT_MAX=1000
# TIMEOUT=60000

# TEST ENVIRONMENT EXAMPLE:
# NODE_ENV=test
# PORT=0
# LOG_LEVEL=error
# CORS_ORIGIN=http://localhost:3001
# RATE_LIMIT_MAX=10000

# STAGING ENVIRONMENT EXAMPLE:
# NODE_ENV=staging
# PORT=8080
# HOST=0.0.0.0
# LOG_LEVEL=debug
# TRUST_PROXY=true
# CORS_ORIGIN=https://staging.yourdomain.com
# HELMET_CSP=true

# ==============================================================================
# SECURITY BEST PRACTICES
# ==============================================================================
#
# SENSITIVE DATA HANDLING:
# - Never commit actual .env files to version control repositories
# - Use secure environment variable systems for production deployments
# - Store different values for each environment (development, staging, production)
# - Regularly rotate secret values and API keys
#
# VALIDATION REQUIREMENTS:
# - Always validate environment variables at application startup
# - Use schema validation for complex configuration objects
# - Provide meaningful error messages for invalid configuration
# - Implement fallback values for non-critical settings
#
# PRODUCTION SECURITY:
# - Use secure random values for production secrets and tokens
# - Enable all security headers and middleware in production
# - Configure appropriate rate limiting and request size limits
# - Use HTTPS-only settings for production deployments
# - Never use debug or development settings in production
#
# ==============================================================================
# DEPLOYMENT INSTRUCTIONS
# ==============================================================================
#
# LOCAL DEVELOPMENT:
# 1. Copy this file to .env: cp .env.example .env
# 2. Modify values according to your local environment
# 3. Start the application: npm start
# 4. Verify configuration at startup console output
#
# CONTAINER DEPLOYMENT:
# 1. Use environment variable injection instead of .env files
# 2. Configure container environment variables through orchestration platform
# 3. Use host binding 0.0.0.0 for container networking
# 4. Enable cluster mode and proxy trust for production containers
#
# CI/CD PIPELINE:
# 1. Use pipeline environment variables for automated deployments
# 2. Configure environment-specific values through CI/CD platform
# 3. Use secret management systems for sensitive configuration
# 4. Test configuration in staging before production deployment
#
# ==============================================================================
# EDUCATIONAL LEARNING OBJECTIVES
# ==============================================================================
#
# This .env.example file demonstrates:
# - Environment variable configuration best practices for Node.js applications
# - Security considerations for environment variable management
# - Multi-environment configuration patterns (development, production, test, staging)
# - Express.js 5.1.0 framework configuration through environment variables
# - Production deployment configuration with security and performance optimization
# - Development workflow configuration with debugging and hot reload support
# - Security middleware configuration including CORS, Helmet.js, and rate limiting
# - Container deployment configuration with appropriate host and port settings
# - Comprehensive documentation and validation patterns for configuration management
#
