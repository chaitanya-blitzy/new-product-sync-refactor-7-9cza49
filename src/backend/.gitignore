*.iws
*.iml
*.ipr
.idea_modules/

# Vim editor files
*.swp
*.swo
*~
.vim/
.netrwhist
Session.vim

# Emacs editor files
.emacs.d/
*~
\#*\#
.\#*

# Sublime Text
.sublime-*
*.sublime-project
*.sublime-workspace

# Atom editor
.atom/

# Nova editor
.nova/

